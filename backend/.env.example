# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=arroyo_seco
DB_USER=postgres
DB_PASSWORD=tu_password_seguro_aqui

# ============================================
# CONFIGURACIÓN DE SEGURIDAD - JWT
# ============================================
# IMPORTANTE: Usa secretos fuertes y únicos (mínimo 32 caracteres)
# Genera secretos seguros con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERA_UN_SECRET_FUERTE_DE_AL_MENOS_32_CARACTERES_AQUI
REFRESH_SECRET=GENERA_OTRO_SECRET_DIFERENTE_AQUI_TAMBIEN_32_CHARS

# ============================================
# CONFIGURACIÓN DE STRIPE (PAGOS)
# ============================================
STRIPE_SECRET_KEY=sk_test_tu_stripe_secret_key
STRIPE_PUBLIC_KEY=pk_test_tu_stripe_public_key

# ============================================
# CONFIGURACIÓN DE EMAIL
# ============================================
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_password_de_aplicacion

# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ============================================
# CONFIGURACIÓN DE FIREBASE
# ============================================
FIREBASE_STORAGE_BUCKET=nameproyecto.firebasestorage.app

# ============================================
# CONFIGURACIÓN DE SEGURIDAD ADICIONAL
# ============================================
# Desactivar rate limiting en desarrollo (no recomendado)
# SKIP_RATE_LIMIT=false

# ============================================
# NOTAS DE SEGURIDAD
# ============================================
# 1. NUNCA subas el archivo .env real a GitHub
# 2. Los secretos JWT deben ser diferentes entre sí
# 3. Usa contraseñas fuertes para la base de datos
# 4. En producción, cambia NODE_ENV=production
# 5. Genera secretos seguros con comandos criptográficos