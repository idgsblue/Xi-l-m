# INSTRUCCIONES:
# 1. Rellena este archivo con tus valores de producción
# 2. NO subas este archivo a git
# 3. Usa este archivo para configurar las variables en Cloud Run

# Database (Cloud SQL o externa)
DB_HOST=tu-host-de-base-de-datos
DB_PORT=5432
DB_NAME=arroyo_seco
DB_USER=tu-usuario
DB_PASSWORD=tu-contraseña-segura

# JWT
JWT_SECRET=genera-un-secret-seguro-aqui
REFRESH_SECRET=genera-otro-secret-seguro-aqui

# Stripe
STRIPE_SECRET_KEY=tu-stripe-secret-key
STRIPE_PUBLIC_KEY=tu-stripe-public-key

# Email
EMAIL_USER=tu-email@gmail.com
EMAIL_PASS=tu-password-de-aplicacion

# Server
PORT=5000
NODE_ENV=production

# Firebase
FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
